{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "审计访谈清单生成工具",
  "version": "0.1.1",
  "identifier": "com.local.audit-interview-desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:frontend && npm run prepare:sidecar",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "审计访谈清单生成工具",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "zeng88",
    "category": "Productivity",
    "shortDescription": "Audit interview checklist desktop tool",
    "longDescription": "A desktop tool for generating audit interview checklists from local project files.",
    "useLocalToolsDir": true,
    "externalBin": [
      "binaries/audit-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ],
        "section": "utils",
        "priority": "optional"
      }
    },
    "resources": []
  }
}
